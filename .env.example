# Strapi CMS
STRAPI_URL=https://cms.sman1kraksaan-web.my.id
STRAPI_TOKEN=ganti-dengan-api-token-read-only

# Opsional: paksa nama plural endpoint bila berbeda (jarang perlu)
# STRAPI_CT_BERITA=beritas

# Token tulis Strapi (custom): izin create pada facility-bookings,
# create+update pada visit-logs. Dipakai /api/bookings (POST) & /api/visit.
# Tanpa ini: pengajuan pemesanan & penghitung kunjungan tidak aktif.
STRAPI_WRITE_TOKEN=

# Asisten AI (/api/chat). Model, prompt, dan pengaturan lain dibaca dari
# single type "ai-config" di Strapi (cache 5 menit); STRAPI_TOKEN perlu izin
# find pada ai-config. Pilih provider di ai-config atau lewat AI_PROVIDER.
# AI_PROVIDER=openrouter   # atau: deepseek
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
