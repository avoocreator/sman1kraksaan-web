{
  "kind": "collectionType",
  "collectionName": "agendas",
  "info": {
    "singularName": "agenda",
    "pluralName": "agendas",
    "displayName": "Agenda",
    "description": "Agenda dan kegiatan sekolah"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 255
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "date": {
      "type": "date",
      "required": true
    },
    "endDate": {
      "type": "date"
    },
    "location": {
      "type": "string",
      "default": "SMAN 1 Kraksaan",
      "maxLength": 180
    },
    "description": {
      "type": "blocks"
    },
    "image": {
      "allowedTypes": ["images"],
      "type": "media",
      "multiple": false
    }
  }
}
